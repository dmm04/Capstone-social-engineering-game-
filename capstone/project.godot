; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Capstone"
run/main_scene="uid://blkrg8y6e0san"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout=""

[autoload]

Global="*res://global.gd"
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"

[dialogic]

directories/dch_directory={
"Player": "res://Godot_Game_Files/endcutscene_emily/Player.dch",
"boss": "res://Godot_Game_Files/chats/boss.dch",
"chats/devil": "res://Godot_Game_Files/chats/devil.dch",
"devil": "res://Godot_Game_Files/Assets/Characters/devil.dch",
"elbow": "res://Godot_Game_Files/chats/elbow.dch",
"endcutscene_emily/devil": "res://Godot_Game_Files/endcutscene_emily/devil.dch",
"lucy": "res://Godot_Game_Files/chats/lucy.dch",
"shareholders": "res://Godot_Game_Files/endcutscene_emily/shareholders.dch",
"unit_test_character": "res://Tests/Resources/unit_test_character.dch"
}
directories/dtl_directory={
"Phil/endcutscene/timeline": "res://Godot_Game_Files/timeline.dtl",
"emilyendscene": "res://Godot_Game_Files/endcutscene/emilyendscene.dtl",
"endcutscene/timeline": "res://Godot_Game_Files/endcutscene/timeline.dtl",
"endcutscene_emily/emilyendscene": "res://Godot_Game_Files/endcutscene_emily/emilyendscene.dtl"
}
layout/style_directory={
"ChatProfile": "res://Godot_Game_Files/chats/ChatProfile.tres"
}
layout/style_list=["res://Godot_Game_Files/chats/ChatProfile.tres"]
layout/default_style=""
glossary/default_case_sensitive=true
variables={
"chatstep": 0,
"end_step": 0
}
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=false
animations/leave_default_length=0.5
animations/leave_default_wait=false
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

